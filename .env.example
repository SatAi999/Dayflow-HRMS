# ==========================================
# Dayflow HRMS - Local Environment Variables
# Copy this file to .env and configure values
# ==========================================

# Backend server configurations
PORT=5000
NODE_ENV=development

# Database configurations
# Use mongodb://localhost:27017/dayflow for local running
MONGODB_URI=mongodb://localhost:27017/dayflow

# Authentication configurations
JWT_SECRET=super_secret_temporary_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Verification Mock Configurations (or real SMTP keys)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=no-reply@dayflow.com
